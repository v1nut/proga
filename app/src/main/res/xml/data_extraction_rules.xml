<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="kbzhu_database.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="encrypted_kbzhu_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kbzhu_database.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="encrypted_kbzhu_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
